# WalletConnect Project ID (from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Deployed Contract Addresses on Sepolia
VITE_VEIL_CLUBS_ADDRESS=0x0000000000000000000000000000000000000000

# Official Zama Sepolia Confidential USDC (Mock) wrapper and underlying mock USDC.
VITE_VEIL_TOKEN_ADDRESS=0x7c5BF43B851c1dff1a4feE8dB225b87f2C223639
VITE_VEIL_UNDERLYING_TOKEN_ADDRESS=0x9b5Cd13b8eFbB58Dc25A05CF411D8056058aDFfF

# Optional: Alchemy / Infura Sepolia RPC URL (falls back to public Sepolia RPCs if empty)
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Backend Service URL
VITE_BACKEND_URL=http://127.0.0.1:8787
